# Mật khẩu đăng nhập trang quản trị (/admin).
ADMIN_PASSWORD=

# Khóa ký cookie phiên đăng nhập. Đổi thành chuỗi ngẫu nhiên dài trước khi chạy thật.
ADMIN_SECRET=doi-chuoi-nay-truoc-khi-chay-that

# Tên miền chính thức, dùng cho sitemap, robots.txt và thẻ Open Graph.
NEXT_PUBLIC_SITE_URL=https://farmstay.vn

# Chuỗi kết nối MongoDB (MongoDB Atlas → Connect → Drivers) và tên database.
MONGODB_URI=
MONGODB_DB=farmstay

# Cloudflare R2: nơi lưu ảnh sản phẩm. Tạo API token có quyền Object Read & Write
# cho bucket, và bật Public access (r2.dev hoặc tên miền riêng) để lấy đường dẫn công khai.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
